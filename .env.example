NODE_ENV=development

# Frontend
VITE_API_BASE_URL=/api

# Core / reliability
CORS_ORIGINS=http://localhost:5173
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_RETRIES=2
UPSTREAM_BACKOFF_MS=250
UPSTREAM_CIRCUIT_BREAKER_THRESHOLD=5
UPSTREAM_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Redis / cache / rate limit (optional)
REDIS_URL=
REDIS_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=80
CACHE_TTL_SEARCH_MS=60000
CACHE_TTL_DETAILS_MS=300000

# Local admin bootstrap credentials
ADMIN_EMAIL=admin@vibeymusic.com
ADMIN_PASSWORD=vibey12345
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_ALLOWED_IPS=
ADMIN_TOKEN=

# Local auth secrets (dev only)
JWT_SECRET=dev-jwt-secret-1234567890
REFRESH_TOKEN_SECRET=dev-refresh-secret-1234567890

# MongoDB (optional; provide both together)
MONGODB_URI=
MONGODB_DB_NAME=
