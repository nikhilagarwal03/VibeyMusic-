{
  "name": "vibeymusic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "jiosaavn-api",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
    "dev:frontend": "vite --port 5173",
    "dev:api": "npm run dev -w jiosaavn-api",
    "build:api": "npm run build -w jiosaavn-api",
    "build:vercel": "npm run build:api && npm run build",
    "build": "vite build",
    "test:frontend": "vitest run",
    "test:api": "npm run test -w jiosaavn-api",
    "typecheck:api": "npm run build -w jiosaavn-api",
    "check": "npm run lint && npm run test:api && npm run build:vercel",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.34.3",
    "hono": "^4.12.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
